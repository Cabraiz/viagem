{
  "name": "viagem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.pure.json && tsc -p backend/tsconfig.json && tsc -p multiplayer/tsconfig.json && tsc -p scripts/bots/tsconfig.json",
    "preview": "node scripts/serve.mjs",
    "test": "node --experimental-strip-types --test --test-concurrency=4 \"tests/**/*.test.ts\"",
    "test:contract": "node --experimental-strip-types --test \"tests/contract/**/*.test.ts\"",
    "test:rules": "node --experimental-strip-types --test \"tests/rules/**/*.test.ts\"",
    "test:maps": "node --experimental-strip-types --test \"tests/maps/**/*.test.ts\"",
    "test:sim": "node --experimental-strip-types --test \"tests/sim/**/*.test.ts\"",
    "test:protocol": "node --experimental-strip-types --test \"tests/protocol/**/*.test.ts\"",
    "test:protocol:stress": "node --experimental-strip-types --test \"tests/protocol/stress/*.stress.ts\"",
    "test:client": "node --experimental-strip-types --test \"tests/client/**/*.test.ts\"",
    "test:rooms": "node --experimental-strip-types --test \"tests/rooms/**/*.test.ts\"",
    "test:api": "node --experimental-strip-types --test \"tests/api/**/*.test.ts\"",
    "test:tools": "node --experimental-strip-types --test \"tests/tools/**/*.test.ts\"",
    "test:arch": "node --experimental-strip-types --test \"tests/arquitetura.test.ts\"",
    "prepare:art": "node scripts/prepare-portraits.mjs",
    "test:multiplayer:local": "node scripts/check-multiplayer-local.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "test:multiplayer:production": "node --experimental-strip-types scripts/check-multiplayer.mjs https://viagem-salas.viagem.workers.dev",
    "deploy:rooms": "node scripts/deploy-rooms.mjs",
    "deploy:rooms:force": "node scripts/deploy-rooms.mjs --force",
    "bots": "node --experimental-strip-types scripts/bots/run.ts",
    "bench:maps": "node --experimental-strip-types scripts/bench-city.ts",
    "bench:city-run": "node --experimental-strip-types scripts/bench-city-run.ts",
    "bench:city-tick": "node --experimental-strip-types scripts/bench-city-tick.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/ws": "^8.18.2",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "^4.147.0",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "rolldown": "1.2.8"
  },
  "dependencies": {
    "phaser": "3.90.0"
  }
}
