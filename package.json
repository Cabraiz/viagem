{
  "name": "viagem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && tsc -p backend/tsconfig.json && tsc -p multiplayer/tsconfig.json",
    "preview": "node scripts/serve.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "prepare:art": "node scripts/prepare-portraits.mjs",
    "test:multiplayer:local": "node scripts/check-multiplayer-local.mjs",
    "test:multiplayer:production": "node scripts/check-multiplayer.mjs https://viagem-salas.viagem.workers.dev",
    "deploy:rooms": "wrangler deploy --config multiplayer/wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/ws": "^8.18.2",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "^4.147.0",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "rolldown": "1.2.8"
  },
  "dependencies": {
    "phaser": "3.90.0"
  }
}
